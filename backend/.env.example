SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
SMARTCAR_REDIRECT_URI=http://localhost:3000/auth/callback
SMARTCAR_CONNECT_MODE=simulated
SMARTCAR_APP_MANAGEMENT_TOKEN=
PORT=3000
FRONTEND_URL=http://localhost:4200
NGROK_AUTHTOKEN=
DATABASE_PATH=./data/smartcar.db

# SAIC / MG iSmart integration
# Key used to encrypt SAIC account credentials at rest (AES-256-GCM).
# Loss of this key makes stored credentials unrecoverable.
SAIC_CREDENTIALS_KEY=
# Region code: eu, au, tr, il, br, in, th, cn (default: il)
SAIC_REGION=il
# Set to "true" to enable automatic background polling. When false (default),
# data is only fetched when you manually refresh from the UI.
SAIC_POLLING_ENABLED=false
# Vehicle status poll interval in ms (default: 30000). Only used when polling is enabled.
# Aggressive polling drains the 12V battery.
SAIC_POLL_INTERVAL_MS=30000
# Set to "true" to log all SAIC API requests and responses to data/saic-api-log.jsonl
SAIC_LOG_REQUESTS=false
